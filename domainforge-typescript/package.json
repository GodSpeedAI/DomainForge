{
  "name": "@godspeedai/domainforge",
  "version": "0.21.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "TypeScript bindings for the SEA (Semantic Enterprise Architecture) DSL",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "napi build --platform --release --manifest-path ../domainforge-core/Cargo.toml --output-dir . --features typescript,three_valued_logic && python3 ../scripts/patch_napi_types.py",
    "build:debug": "napi build --platform --manifest-path ../domainforge-core/Cargo.toml --output-dir . --features typescript,three_valued_logic && python3 ../scripts/patch_napi_types.py",
    "test": "bun vitest run",
    "test:watch": "bun vitest",
    "test:node": "npx vitest run",
    "test:types": "tsc --noEmit --strict --skipLibCheck false -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sea",
    "dsl",
    "domain-modeling",
    "architecture",
    "typescript",
    "rust",
    "napi"
  ],
  "author": "DomainForge Contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GodSpeedAI/DomainForge.git"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "domainforge-core.*.node"
  ],
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8",
    "@types/bun": "^1.1.15",
    "@types/node": "^20.19.25",
    "typescript": "^5.3.0",
    "vitest": "^4.0.10"
  },
  "engines": {
    "node": ">= 18",
    "bun": ">= 1.1.0"
  },
  "napi": {
    "binaryName": "domainforge-core",
    "targets": [
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  }
}
