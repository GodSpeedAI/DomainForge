{
  "$schema": "https://raw.githubusercontent.com/jetpack-io/devbox/main/.schema/devbox.schema.json",
  "packages": [
    "rustup@1.29.0",
    "just",
    "bun",
    "nodejs",
    "python3",
    "libxml2@latest",
    "elan@latest"
  ],
  "env": {
    "RUSTUP_TOOLCHAIN": "1.92.0",
    "VENV_DIR":         ".devbox/virtenv/python/.venv"
  },
  "shell": {
    "init_hook": [
      "export PATH=\"$HOME/.cargo/bin:$PATH\""
    ],
    "scripts": {
      "install-domainforge": "cargo install domainforge-core --version 0.16.0 --features cli --locked --force"
    }
  }
}
