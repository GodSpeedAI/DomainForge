{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://domainforge.dev/schemas/evaluate-output.v1.json",
  "title": "DomainForge Evaluate Output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "compiler",
    "model_sha256",
    "source_set_hash",
    "facts_sha256",
    "world_ref",
    "policies",
    "model_instance_count",
    "facts_instance_count"
  ],
  "definitions": {
    "result": {
      "enum": [
        "true",
        "false",
        "unknown"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "properties": {
    "schema": {
      "const": "domainforge.evaluate-output.v1"
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "model_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "source_set_hash": {
      "$ref": "#/definitions/sha256"
    },
    "facts_sha256": {
      "$ref": "#/definitions/sha256"
    },
    "world_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "world:<name>@sha256:<hex>; null unless --world-name is given."
    },
    "policies": {
      "type": "array",
      "description": "Ordered by policy_id, then operation name.",
      "items": {
        "type": "object",
        "required": [
          "policy_id",
          "policy",
          "namespace",
          "kind",
          "modality",
          "operation_bound",
          "result"
        ],
        "properties": {
          "policy_id": {
            "type": "string"
          },
          "policy": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "modality": {
            "type": "string"
          },
          "operation_bound": {
            "type": "boolean"
          },
          "operation": {
            "type": "string",
            "description": "Present when operation_bound; one row per policy, operation and input set (no aggregate)."
          },
          "result": {
            "$ref": "#/definitions/result"
          },
          "support": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Graph policies only: instances the outermost quantifier ranged over; 0 means vacuous; null when the policy has no quantifier."
          },
          "binding_depth": {
            "const": "outermost"
          },
          "reason": {
            "enum": [
              "no_operation_input",
              "unknown_input",
              "evaluation_error"
            ]
          },
          "error": {
            "type": "string"
          },
          "bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "result"
              ],
              "properties": {
                "entity": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "namespace": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "instance": {
                  "type": "string"
                },
                "instance_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "result": {
                  "$ref": "#/definitions/result"
                },
                "source": {
                  "enum": [
                    "model",
                    "facts"
                  ]
                }
              }
            }
          },
          "input_set_id": {
            "type": "string",
            "description": "Operation-bound rows: the input set this row was evaluated for. Absent with reason no_operation_input."
          }
        }
      }
    },
    "model_instance_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Instances declared in the model itself."
    },
    "facts_instance_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Instances loaded from the facts file."
    }
  }
}
