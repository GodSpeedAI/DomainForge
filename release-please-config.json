{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "include-v-in-release-name": true,
  "bootstrap-sha": "dfa8e4505b0ce5a05314cf4cbea7dec167a5160a",
  "pull-request-title-pattern": "chore: release ${component} ${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "refactor", "section": "Refactoring", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "chore", "section": "Miscellaneous", "hidden": true },
    { "type": "build", "section": "Build System", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "DomainForge",
      "component": "domainforge",
      "version-file": "version.txt",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "domainforge-core/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "domainforge-python/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "json",
          "path": "domainforge-typescript/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
